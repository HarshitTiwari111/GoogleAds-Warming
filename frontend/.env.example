# Leave unset for local development: Vite proxies /api to the backend
# (see vite.config.js), so relative requests just work.
# VITE_API_BASE_URL=http://localhost:5000/api

# Production on a separate domain from the backend:
# VITE_API_BASE_URL=https://api.example.com/api

VITE_POLL_INTERVAL_MS=15000
