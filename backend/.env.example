# =========================================================================
# Merged Google Ads Automation + Warming/Farming backend
#
# Every variable below is the exact name read by src/config/env.js.
# Copy this file to backend/.env and fill in what you need.
# =========================================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# Where the frontend is served. Used for the OAuth return URL.
FRONTEND_URL=http://localhost:5173
# Comma-separated list, or * to allow any origin (development only).
CORS_ORIGIN=http://localhost:5173

# ---------- MongoDB ----------
MONGODB_URI=mongodb://127.0.0.1:27017/google-ads-automation

# ---------- Auth ----------
# Both MUST be set to strong random values in production — the server
# refuses to boot with the development defaults when NODE_ENV=production.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_EXPIRES_IN=7d

# Seed admin, created on first boot if no admin exists.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ---------- Google Ads API ----------
# true  = generate simulated metrics, never call Google Ads (safe default)
# false = use the real API with the credentials below
GOOGLE_ADS_SIMULATION_MODE=true
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Fallback manager (MCC) account. Per-user MCC lists are managed in the app
# under Settings → Manager Accounts and take precedence over this value.
GOOGLE_ADS_MANAGER_ACCOUNT_ID=

# OAuth proxy that exchanges the Google login for a refresh token.
OAUTH_PROXY_URL=https://secure.dataram.workers.dev/auth/login

# ---------- Campaign defaults ----------
# Pre-filled on the creation forms. The operator always sets the real value
# per account/campaign — nothing is randomised.
DEFAULT_DAILY_BUDGET=1
DEFAULT_CAMPAIGN_NAME_PREFIX=Warmup
WARMUP_DAYS=14

# ---------- Telegram alerts ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Email (SMTP) ----------
# Used for dashboard notification emails (account created, status changed).
# The Google Ads *access invitation* is sent by Google itself and does not
# need these.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ---------- Scheduler ----------
CAMPAIGN_FETCH_CRON=*/1 * * * *
MONITORING_CRON=0 */6 * * *
DAILY_REPORT_CRON=0 0 * * *
WEEKLY_REPORT_CRON=0 1 * * 1

# ---------- Alerting ----------
DEFAULT_ALERT_COOLDOWN_MINUTES=15
DEFAULT_SPEND_LIMIT=50
CLICK_FREQUENCY_LIMIT=4
GCLID_COUNT_LIMIT=4

# ---------- No-clicks auto-warning & auto-pause ----------
NO_CLICKS_WARNING_LIMIT=3
NO_CLICKS_MONITORING_PERIOD_MINUTES=5

# ---------- Data retention (TTL indexes, in days) ----------
ALERT_HISTORY_RETENTION_DAYS=30
METRICS_RETENTION_DAYS=30
LANDING_CLICKS_RETENTION_DAYS=30
GCLID_RETENTION_DAYS=180
